# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (e.g. https://parking-s-gtest.vercel.app).
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="https://parking-s-gtest.vercel.app"

# LTA_ACCOUNT_KEY: Land Transport Authority (LTA) DataMall Account Key.
# Used to authenticate API calls to LTA DataMall endpoints.
LTA_ACCOUNT_KEY="MY_LTA_ACCOUNT_KEY"

# MCP_SERVERS: Comma-separated list of Streamable HTTP MCP server addresses.
# The Gemini agent at /api/ask connects to these tools.
MCP_SERVERS="https://mcp-trial-ebon.vercel.app/api/mcp,https://chatwithsandra.singstat.gov.sg/mcp"

# ALERT_WEBHOOK_URL: Webhook URL for external alert notifications (e.g. Discord, Slack, Telegram).
# When a user approves an alert drafted by the agent, /api/send-alert posts to this endpoint.
ALERT_WEBHOOK_URL="https://discord.com/api/webhooks/your-webhook-id/your-webhook-token"

